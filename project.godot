; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Night Shift: Not Human"
config/version="0.2.3"
config/description="A first-person night-shift horror game. Scan groceries. Watch the customers. Some of them are not people."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.02, 0.025, 0.03, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
GameData="*res://scripts/autoload/game_data.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
UpdateManager="*res://scripts/autoload/update_manager.gd"
Diagnostics="*res://scripts/autoload/diagnostics.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://data/": "yellow",
"res://scenes/": "purple",
"res://scripts/": "blue"
}

[night_shift]

version_code=5

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="customer"
3d_physics/layer_4="interactable"
3d_physics/layer_5="item"

[physics]

3d/default_gravity=18.0

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
global_illumination/gi/use_half_resolution=true
textures/default_filters/anisotropic_filtering_level=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.03, 1)
occlusion_culling/use_occlusion_culling=true
